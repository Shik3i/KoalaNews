DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Registration
ALLOW_REGISTRATION="true"

# Admin bootstrap (created on first start, ignored if any admin already exists)
ADMIN_EMAIL="admin@koalanews.example"
ADMIN_PASSWORD="change-me-please"

# Google OAuth (optional – for social login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Note: A server pepper is auto-generated on first start and stored in the database.
# No PEPPER env var needed.
