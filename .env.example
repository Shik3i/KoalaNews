# Reverse-proxy port (host side)
HTTP_PORT=80

# New app (website/)
SESSION_KEY=change-me-to-a-random-string
SYNC_INTERVAL=15m

# Legacy app (website_legacy/) — only needed while it's still running for fallback
NEXTAUTH_SECRET=change-me-to-a-random-string
NEXTAUTH_URL=http://localhost
ALLOW_REGISTRATION=true
ADMIN_EMAIL=admin@koalanews.local
ADMIN_PASSWORD=change-me-please
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
